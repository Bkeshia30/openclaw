# Copy to .env.local and fill in. NEVER commit .env.local.
# A leaked service role key bypasses every RLS policy you wrote — it is a full breach.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never NEXT_PUBLIC_
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Used only by `npm test` against a local Postgres. Not needed to run the app.
TEST_DATABASE_URL=postgresql://postgres@localhost:55432/salon_test
