{
  "name": "Executors Desk - Pinterest pin scheduler",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "10 9 * * *"
            }
          ]
        }
      },
      "name": "Daily 09:10",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "documentId": "={{ $env.PIN_SHEET_ID }}",
        "sheetName": "pins",
        "options": {}
      },
      "name": "Read pin queue",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        220,
        0
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "",
          "name": "Google Sheets"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\nconst next = rows.find(r => !r.posted_at);\nif (!next) return [];\nconst dest = next.destination === 'etsy' ? $env.ETSY_LISTING_URL : next.destination === '/blog' ? ($env.SITE_URL + '/blog') : ($env.SITE_URL + '/72');\nconst utm = `?utm_source=pinterest&utm_medium=pin&utm_campaign=pin-${next.id}`;\nconst desc = `${next.fact} ${next.why} Free 72-hour checklist at theexecutorsdesk.com/72.`;\nreturn [{ json: { ...next, link: dest + utm, description: desc.slice(0, 480) } }];"
      },
      "name": "Pick next unposted pin",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "url": "={{ $env.PIN_RENDER_URL }}",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ title: $json.title, board: $json.board }) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          }
        }
      },
      "name": "Render pin image (HTML->PNG service)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "operation": "binaryToPropery",
        "binaryPropertyName": "data",
        "destinationKey": "image_b64",
        "options": {}
      },
      "name": "Image to base64",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [
        770,
        0
      ]
    },
    {
      "parameters": {
        "url": "https://api.pinterest.com/v5/pins",
        "method": "POST",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "pinterestOAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ board_id: $('Pick next unposted pin').item.json.board_id, title: $('Pick next unposted pin').item.json.title, description: $('Pick next unposted pin').item.json.description, link: $('Pick next unposted pin').item.json.link, media_source: { source_type: 'image_base64', content_type: 'image/png', data: $json.image_b64 } }) }}",
        "options": {}
      },
      "name": "Create pin",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        990,
        0
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "operation": "update",
        "documentId": "={{ $env.PIN_SHEET_ID }}",
        "sheetName": "pins",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "id": "={{ $('Pick next unposted pin').item.json.id }}",
            "posted_at": "={{ $now.toISO() }}",
            "pin_id": "={{ $json.id }}"
          },
          "matchingColumns": [
            "id"
          ]
        },
        "options": {}
      },
      "name": "Mark posted",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1210,
        0
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $env.OWNER_CHAT_ID }}",
        "text": "=Pin failed: {{ $('Pick next unposted pin').item.json.title }} \u2014 {{ $json.error?.message || $json.message || 'see n8n execution log' }}"
      },
      "name": "Notify owner on failure",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1210,
        220
      ],
      "credentials": {
        "telegramApi": {
          "id": "",
          "name": "Telegram"
        }
      }
    }
  ],
  "connections": {
    "Daily 09:10": {
      "main": [
        [
          {
            "node": "Read pin queue",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read pin queue": {
      "main": [
        [
          {
            "node": "Pick next unposted pin",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Pick next unposted pin": {
      "main": [
        [
          {
            "node": "Render pin image (HTML->PNG service)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Render pin image (HTML->PNG service)": {
      "main": [
        [
          {
            "node": "Image to base64",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create pin": {
      "main": [
        [
          {
            "node": "Mark posted",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Notify owner on failure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Image to base64": {
      "main": [
        [
          {
            "node": "Create pin",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "errorWorkflow": "",
    "executionOrder": "v1"
  },
  "meta": {
    "notes": "Sheet 'pins' columns: id, title, board, board_id, destination, fact, why, posted_at, pin_id. Seed it from 05-traffic/pinterest-plan.md. PIN_RENDER_URL: any HTML-to-image endpoint (self-hosted Playwright service, or the OpenClaw skill script render_pin.mjs behind a tiny HTTP wrapper)."
  }
}